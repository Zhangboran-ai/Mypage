# 数据库（Neon，通过 Vercel Marketplace 创建后自动注入）
# 运行时使用 pooled 连接；迁移与 seed 使用 direct 连接
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Vercel Blob（在 Vercel Marketplace 创建后自动注入）
# 新版 Blob 也可能只注入 BLOB_STORE_ID + VERCEL_OIDC_TOKEN，SDK 会自动读取
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# 站点：canonical / OG / sitemap 的绝对地址
# 生产环境可留空，构建时回退到 https://$VERCEL_PROJECT_PRODUCTION_URL
PUBLIC_SITE_URL=http://localhost:3000

# 仅 pnpm db:seed 使用
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123456
# 设为 true 时额外写入示例文章与项目
SEED_SAMPLE_DATA=false

# 可选：发布内容后触发 Vercel Deploy Hook 重建静态页
DEPLOY_HOOK_URL=

# 可选：API 集成测试使用的独立数据库（不要指向生产库）
DATABASE_URL_TEST=

# 可选：pnpm dev:api 的端口，默认 3001
PORT=3001
